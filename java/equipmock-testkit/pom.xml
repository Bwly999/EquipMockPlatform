<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.equipmock</groupId>
    <artifactId>equipmock-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>equipmock-testkit</artifactId>
  <name>EquipMock Testkit (插件自测试工具包)</name>

  <dependencies>
    <!-- testkit 是被插件模块以 test scope 引用的工具包，JUnit API 需随包提供 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <!-- 覆盖父 POM 的 test scope：此处 compile -->
      <scope>compile</scope>
    </dependency>
    <!-- 读取 state.json（lastWriteAt/plugins[].state）做轮询断言；版本由父 POM 管理 -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.equipmock</groupId>
      <artifactId>equipmock-plugin-api</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 环境适配（非设计偏离）：离线仓库缺 surefire 2.22.2 的 junit-platform provider，模块内覆写 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <dependencies>
          <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.9.3</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
