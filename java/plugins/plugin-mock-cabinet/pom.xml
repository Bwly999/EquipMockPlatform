<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.equipmock</groupId>
    <artifactId>equipmock-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>plugin-mock-cabinet</artifactId>
  <name>EquipMock 示例插件 A：机柜电源 Mock</name>

  <dependencies>
    <!-- 插件关键依赖一律 provided：运行时由 agent jar 提供，不打进插件包 -->
    <dependency>
      <groupId>com.equipmock</groupId>
      <artifactId>equipmock-plugin-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.pf4j</groupId>
      <artifactId>pf4j</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- 自测试（05 §4）：testkit + 目标类（demo-host）仅测试期 -->
    <dependency>
      <groupId>com.equipmock</groupId>
      <artifactId>equipmock-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.equipmock</groupId>
      <artifactId>demo-host</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>mock-cabinet-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Plugin-Id>mock-cabinet</Plugin-Id>
              <Plugin-Version>${project.version}</Plugin-Version>
              <Plugin-Requires>equipmock &gt;=1.0.0</Plugin-Requires>
              <Plugin-Description>机柜电源硬件 Mock（示例插件）</Plugin-Description>
              <Plugin-Provider>EquipMock</Plugin-Provider>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <!-- surefire argLine 挂 agent：见 05 §4.1，testkit 就绪后启用
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-javaagent:${agent.jar} -Dequipmock.home=${project.build.directory}/equipmock-test-home</argLine>
        </configuration>
      </plugin>
      -->
    </plugins>
  </build>
</project>
