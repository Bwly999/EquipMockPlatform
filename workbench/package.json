{
  "name": "equipmock-workbench",
  "version": "1.0.0",
  "description": "EquipMock 桌面工作台（配置中心 / 插件管理 / Agent 状态）",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "author": "EquipMock",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm typecheck && pnpm build:renderer && pnpm build:electron && node scripts/check-no-cdn.mjs",
    "check:no-cdn": "node scripts/check-no-cdn.mjs",
    "dist": "electron-builder --win --config electron-builder.yml",
    "sync-version": "node scripts/sync-version.mjs",
    "gen-icon": "node scripts/gen-icon.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "monaco-editor": "0.54.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "43.1.0",
    "electron-builder": "26.0.12",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.0.16"
  }
}
