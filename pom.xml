<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.equipmock</groupId>
  <artifactId>equipmock-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>EquipMock Parent</name>
  <description>装备软件 Mock 平台（Java Agent + 工作台）</description>

  <modules>
    <module>java/equipmock-bootstrap</module>
    <module>java/equipmock-plugin-api</module>
    <module>java/equipmock-agent</module>
    <module>java/equipmock-testkit</module>
    <module>java/plugins/plugin-mock-cabinet</module>
    <module>java/plugins/plugin-mock-radar</module>
    <module>java/demo-host</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <byte-buddy.version>1.9.16</byte-buddy.version>
    <pf4j.version>3.12.0</pf4j.version>
    <gson.version>2.8.9</gson.version>
    <junit.version>5.8.2</junit.version>
    <surefire.version>2.22.2</surefire.version>
    <shade.version>3.2.4</shade.version>
    <jar-plugin.version>3.2.0</jar-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 平台内部模块 -->
      <dependency>
        <groupId>com.equipmock</groupId>
        <artifactId>equipmock-bootstrap</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.equipmock</groupId>
        <artifactId>equipmock-plugin-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.equipmock</groupId>
        <artifactId>equipmock-agent</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.equipmock</groupId>
        <artifactId>equipmock-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.equipmock</groupId>
        <artifactId>demo-host</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- 第三方（agent 侧 shade+relocate；插件侧 provided） -->
      <dependency>
        <groupId>net.bytebuddy</groupId>
        <artifactId>byte-buddy</artifactId>
        <version>${byte-buddy.version}</version>
      </dependency>
      <dependency>
        <groupId>org.pf4j</groupId>
        <artifactId>pf4j</artifactId>
        <version>${pf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${gson.version}</version>
      </dependency>
      <!-- 测试 -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
